{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "fluid": true,
  "crons": [
    {
      "path": "/api/cron/monitor",
      "schedule": "30 4 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.aitchek.online"
        }
      ],
      "destination": "https://aitchek.online/:path*",
      "permanent": true
    }
  ]
}
